# Firmware (ESP-IDF)
firmware/build/
firmware/managed_components/
firmware/sdkconfig.old

# sdkconfig holds real Wi-Fi and MQTT credentials in plain text for this
# project. Keep it local; a fresh clone regenerates it via menuconfig,
# using the placeholders already declared in Kconfig.projbuild.
firmware/sdkconfig

# Separate build for AWS IoT Core. Its sdkconfig holds the same Wi-Fi
# credentials.
firmware/build-aws/
firmware/sdkconfig.aws
firmware/sdkconfig.aws.old

# Private keys never belong in the repo, wherever they end up. AWS device
# keys live outside it and reach each board through tools/aws_identity.py.
*.key

# Gateway (only relevant if it's ever built outside Docker)
gateway/build/

# Local assistant notes, intentionally not part of the repo
CLAUDE.md

# Python bytecode, e.g. from running the alarms Lambda's tests
__pycache__/

# OS/editor noise
.DS_Store
Thumbs.db
*.code-workspace
