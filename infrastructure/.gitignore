# Local Docker secret values. Never commit these files.
secrets/*.txt

# TLS private keys and the Mosquitto password file are also local secrets.
mosquitto/certs/*.key
mosquitto/certs/*.srl
mosquitto/config/passwd

# Runtime data and logs generated by the running broker, not source.
mosquitto/data/*
!mosquitto/data/.gitkeep
mosquitto/log/*
!mosquitto/log/.gitkeep

# Bridge to AWS IoT Core: the active config carries the account's endpoint,
# and the edge's certificate folder holds its private key.
mosquitto/config/conf.d/*
!mosquitto/config/conf.d/.gitkeep
mosquitto/certs/aws/
