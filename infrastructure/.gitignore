# Local Docker secret values. Never commit these files.
secrets/*.txt

# TLS private keys and the Mosquitto password file are also local secrets.
mosquitto/certs/*.key
mosquitto/certs/*.srl
mosquitto/config/passwd

# Runtime data and logs generated by the running broker, not source.
mosquitto/data/*
!mosquitto/data/.gitkeep
mosquitto/log/*
!mosquitto/log/.gitkeep

