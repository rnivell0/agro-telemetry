      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "agro-influxdb"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) =>\n    r._measurement == \"device_telemetry\" and\n    r.device_id == \"${device_id}\" and\n    r._field == \"temperature_c\"\n  )\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"temperature\")",
          "refId": "A"
        }
      ],
      "title": "Temperatura",
      "type": "timeseries"
    },
