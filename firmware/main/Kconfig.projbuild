menu "Agro Telemetry"

    config AGRO_WIFI_SSID
        string "Wi-Fi SSID"
        default "YOUR_WIFI_SSID"
        help
            Nombre de la red Wi-Fi a la que se conectará el nodo.

    config AGRO_WIFI_PASSWORD
        string "Wi-Fi password"
        default "YOUR_WIFI_PASSWORD"
        help
            Contraseña de la red Wi-Fi. WifiManager nunca la registra.

    config AGRO_MQTT_BROKER_URI
        string "MQTT broker URI"
        default "mqtts://192.168.1.28:8883"
        help
            Direccion LAN del broker Mosquitto, sobre TLS (puerto 8883).
            No utilizar localhost.

    config AGRO_MQTT_USERNAME
        string "MQTT username"
        default "esp32-node-01"
        help
            Usuario dado de alta en el archivo de contraseñas de Mosquitto.
            Es el mismo para todos los nodos: cada uno se identifica por
            su MAC (client ID esp32-xxxxxx), no por este usuario.

    config AGRO_MQTT_PASSWORD
        string "MQTT password"
        default "CHANGE_ME"
        help
            Contraseña del usuario MQTT. MqttClient nunca la registra por log.

endmenu
